{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EAS_BUILD_SKIP_LOCKFILE_CHECK": "1",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a,armeabi-v7a"
      }
    },
    "emulator": {
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EAS_BUILD_SKIP_LOCKFILE_CHECK": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "env": {
        "EAS_BUILD_SKIP_LOCKFILE_CHECK": "1"
      }
    }
  }
}
